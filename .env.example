# =====================================================================
# NEXUS STORE BOT - INTERNATIONAL ENVIRONMENT CONFIGURATION (.env)
# =====================================================================

# 1. Telegram Core
BOT_TOKEN=8707705709:AAGvLL9YCKKU83rQwh2FBrK8CHaTSCTI7WQ
OWNER_ID=7125722408
ADMIN_IDS=7125722408
SUPPORT_USERNAME=nexus_supportchat

# 2. Database Connection
# SQLite (zero setup, plug-and-play):
DATABASE_URL=sqlite+aiosqlite:///nexus_hub.db
# PostgreSQL / Supabase (Production option):
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxx.supabase.co:5432/postgres

# 3. Base Store Currency & Limits (USD for Global E-Commerce)
BASE_CURRENCY=USD
MIN_DEPOSIT_AMOUNT=1.0
MAX_DEPOSIT_AMOUNT=5000.0

# 4. Cryptocurrency Automation (@CryptoBot / CryptoPay API)
# Get your free token in Telegram: Open @CryptoBot -> send /pay -> Create App -> copy API Token
CRYPTO_PAY_TOKEN=

# 5. Telegram Stars
# Approx $0.02 per 1 Star (50 Stars = $1.00)
STARS_RATE_USD=0.02

# 6. Optional Local Payment Accounts (Ethiopian Banks)
TELEBIRR_RECEIVER_PHONE=09xxxxxxxx
TELEBIRR_RECEIVER_NAME=Nexus Store
CBE_ACCOUNT_NUMBER=1000xxxxxxxx
CBE_ACCOUNT_NAME=Melaku abraham

# 7. External Supplier API (Optional - AIVerse Hub)
AIVERSE_API_KEY=
AIVERSE_BASE_URL=https://aiversehub.store

# 8. Referral Program (%)
REFERRAL_PERCENT=5

# 9. Channel Management & Logging
# Mandatory Force Join channels (e.g. @mychannel or -1001111111)
FORCE_JOIN_CHANNELS=

# Activity logs & notifications:
# Option A: Single channel for everything (fill LOGS_CHANNEL_ID)
# Option B: Separate channels (fill each channel ID)
LOGS_CHANNEL_ID=
PAYMENTS_CHANNEL_ID=
ORDERS_CHANNEL_ID=
REVIEWS_CHANNEL_ID=

# 10. Web Server Keep-Alive (Port 8080 for Render / Railway)
PORT=8080
SECRET_KEY=nexus_store_secret_production_key
