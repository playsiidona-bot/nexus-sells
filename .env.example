# =====================================================================
# NEXUS HUB BOT - ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. Telegram Core
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
OWNER_ID=123456789
ADMIN_IDS=123456789,987654321
SUPPORT_USERNAME=nexus_support

# 2. Database Connection
# SQLite (zero setup, plug-and-play):
DATABASE_URL=sqlite+aiosqlite:///nexus_hub.db
# PostgreSQL / Supabase (Production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nexus_hub

# 3. Ethiopian Local Payment Accounts
BASE_CURRENCY=ETB
TELEBIRR_RECEIVER_PHONE=0912345678
TELEBIRR_RECEIVER_NAME=Nexus Digital Hub
CBE_ACCOUNT_NUMBER=1000123456789
CBE_ACCOUNT_NAME=Nexus Digital Hub
MIN_DEPOSIT_AMOUNT=20
MAX_DEPOSIT_AMOUNT=50000

# 4. Supplier Automation (AIVerse Hub API)
AIVERSE_API_KEY=AK_YOUR_AIVERSE_KEY_HERE
AIVERSE_BASE_URL=https://aiversehub.store

# 5. Global Payments (Optional)
# Telegram Stars: ETB equivalent per 1 Star (e.g. 1 Star = 25 ETB -> 0.04 Stars/ETB)
STARS_RATE_ETB=25.0
CRYPTO_PAY_TOKEN=

# 6. Referral & Growth
REFERRAL_PERCENT=5

# 7. Channel Management & Logging
# Force Join: supports single channel or comma-separated (-100111,-100222 or @chan1,@chan2)
FORCE_JOIN_CHANNELS=

# Log Channels:
# 💡 Option A (Single Channel for everything): Just fill LOGS_CHANNEL_ID and leave the others empty.
# 💡 Option B (Separate Channels): Fill PAYMENTS_CHANNEL_ID, ORDERS_CHANNEL_ID, and REVIEWS_CHANNEL_ID.
# 💡 Option C (Multiple Channels): Any channel field can accept comma-separated IDs (e.g. -100111,-100222).
LOGS_CHANNEL_ID=
PAYMENTS_CHANNEL_ID=
ORDERS_CHANNEL_ID=
REVIEWS_CHANNEL_ID=

# 8. Web Server & Deployment (Render / VPS)
PORT=8080
SECRET_KEY=nexus_hub_secret_key_change_in_production

